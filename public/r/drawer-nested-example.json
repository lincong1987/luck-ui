{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-nested-example",
  "title": "Drawer Nested Example",
  "description": "Atomic example for the Luck UI Drawer component.",
  "registryDependencies": [
    "drawer",
    "button"
  ],
  "files": [
    {
      "path": "registry/default/examples/drawer-nested-example.tsx",
      "content": "import {\r\n  Drawer,\r\n  DrawerBody,\r\n  DrawerClose,\r\n  DrawerContent,\r\n  DrawerDescription,\r\n  DrawerFooter,\r\n  DrawerHeader,\r\n  DrawerTitle,\r\n  DrawerTrigger,\r\n} from \"registry/default/ui/drawer\";\r\nimport { Button } from \"registry/default/ui/button\";\r\nexport function DrawerNestedExample() {\r\n  return (\r\n    <Drawer>\r\n      <DrawerTrigger render={<Button variant=\"outline\">Open Drawer</Button>} />\r\n      <DrawerContent showBar>\r\n        <DrawerHeader>\r\n          <DrawerTitle>Account</DrawerTitle>\r\n          <DrawerDescription>Manage your account settings.</DrawerDescription>\r\n        </DrawerHeader>\r\n        <DrawerBody>\r\n          <p className=\"text-sm text-muted-foreground\">\r\n            Drawers can be nested. Opening one from inside another pushes the parent back.\r\n          </p>\r\n        </DrawerBody>\r\n        <DrawerFooter direction=\"row\">\r\n          <DrawerClose render={<Button variant=\"secondary\">Close</Button>} />\r\n          <Drawer>\r\n            <DrawerTrigger render={<Button>Delete account</Button>} />\r\n            <DrawerContent showBar>\r\n              <DrawerHeader>\r\n                <DrawerTitle>Are you sure?</DrawerTitle>\r\n                <DrawerDescription>\r\n                  This action cannot be undone. Your account will be permanently removed.\r\n                </DrawerDescription>\r\n              </DrawerHeader>\r\n              <DrawerFooter direction=\"row\">\r\n                <DrawerClose render={<Button variant=\"secondary\">Cancel</Button>} />\r\n                <DrawerClose render={<Button>Delete</Button>} />\r\n              </DrawerFooter>\r\n            </DrawerContent>\r\n          </Drawer>\r\n        </DrawerFooter>\r\n      </DrawerContent>\r\n    </Drawer>\r\n  );\r\n}\r\n",
      "type": "registry:component",
      "target": "components/drawer-nested-example.tsx"
    }
  ],
  "type": "registry:component"
}